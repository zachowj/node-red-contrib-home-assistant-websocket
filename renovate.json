{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "github-actions"],
  "schedule": ["* * * * 1"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["flat"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["lowdb"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/express", "@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/node-red", "eslint"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
